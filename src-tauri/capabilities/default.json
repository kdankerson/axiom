{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "axiom-sidecar-win", "cmd": "sidecar-bin/axiom-sidecar.exe", "args": false, "sidecar": false },
        { "name": "axiom-sidecar-unix", "cmd": "sidecar-bin/axiom-sidecar", "args": false, "sidecar": false }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        { "name": "axiom-sidecar-win", "cmd": "sidecar-bin/axiom-sidecar.exe", "args": false, "sidecar": false },
        { "name": "axiom-sidecar-unix", "cmd": "sidecar-bin/axiom-sidecar", "args": false, "sidecar": false }
      ]
    }
  ]
}
